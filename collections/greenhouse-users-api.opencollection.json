{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Harvest Applications Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://harvest.greenhouse.io/v1/users"
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Retrieve user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://harvest.greenhouse.io/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve user"
        },
        {
          "info": {
            "name": "Update user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://harvest.greenhouse.io/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update user"
        },
        {
          "info": {
            "name": "Get current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://harvest.greenhouse.io/v1/current_user"
          },
          "docs": "Get current user"
        }
      ]
    }
  ],
  "bundled": true
}